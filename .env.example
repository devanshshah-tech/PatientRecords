# Copy to .env.local for development. Shell/service variables take precedence.
DJANGO_DEBUG=true
PREVIEW_MODE=false
CLINICAL_UPLOADS_ENABLED=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
SOCIAL_AUTH_GOOGLE_CLIENT_ID=
SOCIAL_AUTH_GOOGLE_SECRET=
# Required when DJANGO_DEBUG=false
# Neon CLI fills these URLs in the ignored .env.local/.env. Never commit real values.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Use the unpooled URL only for migrations/admin operations.
DJANGO_DATABASE_UNPOOLED=false
# Set false for isolated tests/CI that must not read local credentials.
DJANGO_LOAD_ENV_FILES=true
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
PRIVATE_MEDIA_ROOT=
TRUST_HTTPS_PROXY=false
PHOTO_STORAGE=filesystem
# Set only after Drive setup + synthetic verification. Never commit token JSON.
DRIVE_CREDENTIALS_FILE=
DRIVE_ROOT_FOLDER_ID=
# Only needed with PHOTO_STORAGE=s3. Keep bucket and endpoint private.
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION_NAME=us-east-1
# SMTP is optional for account notifications; never sends clinical images.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
